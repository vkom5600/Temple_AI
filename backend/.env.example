
# ==========================================
# TEMPLE AI OPERATIONS AND MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION - POSTGRESQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=temple_management
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=1d

# ==========================================
# CLAUDE AI - ANTHROPIC API
# ==========================================

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ==========================================
# GOOGLE CALENDAR API
# ==========================================

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth2callback

GOOGLE_CALENDAR_ID=primary

GOOGLE_OAUTH_STATE_SECRET=YOUR_RANDOM_OAUTH_STATE_SECRET

GOOGLE_TOKEN_PATH=./private/google-calendar-token.json

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

FRONTEND_URL=http://localhost:5173
