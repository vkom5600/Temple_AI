# ==========================================
# TEMPLE AI - BACKEND ENVIRONMENT
# Copy to .env and fill in. Never commit .env.
# ==========================================

PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=temple_ai
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ---------- JWT ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# ---------- Demo data (development only) ----------
# Password shared by every demo account created by `npm run db:seed`
DEMO_PASSWORD=Temple@1234

# ---------- First chairman (production setup, `npm run create-admin`) ----------
INITIAL_CHAIRMAN_NAME=
INITIAL_CHAIRMAN_EMAIL=
INITIAL_CHAIRMAN_PASSWORD=

# ---------- Email ----------
# Leave SMTP_HOST empty in development: emails are printed in the terminal.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Temple AI <no-reply@temple.local>

# ---------- Phase 3: Claude AI ----------
ANTHROPIC_API_KEY=

# ---------- Phase 3: Google Calendar ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth2callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_PATH=./private/google-calendar-token.json
